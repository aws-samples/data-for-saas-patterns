# Settings for the docker compose stack: `source scripts/docker.env`
# (scripts/local-up.sh writes the equivalent file for the Homebrew stack.)
#
# The fdw values matter: postgres_fdw connects FROM the management container, where
# "localhost" is that container itself. It has to reach the V1 databases by service name.
export FDW_V1_MESSAGING_HOST=v1-messaging FDW_V1_MESSAGING_PORT=5432
export FDW_V1_AUTH_HOST=v1-auth FDW_V1_AUTH_PORT=5432
export TENANTMIG_SANDBOX=1
export PLACEMENT_CACHE_TTL_SECONDS=2
