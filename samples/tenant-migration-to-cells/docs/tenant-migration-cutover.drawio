<mxfile><diagram name="Cutover lifecycle" id="page-1"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;One tenant's migration: Clone → Flip → Redirect → Forget&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;V1 stays authoritative until Redirect, so any failure before it is a rollback by status change. tenant_placement.status shown in each phase.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1300" height="50" as="geometry"/></mxCell>
<mxCell id="p0" value="&lt;b&gt;Served by V1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reads and writes go to V1.&lt;br&gt;&lt;i&gt;status: v1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=12;fontColor=#232F3E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="170" height="130" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;1. Clone&lt;/b&gt; (repeatable)&lt;br&gt;&lt;br&gt;Bulk content pass&lt;br&gt;Delta passes from the watermark&lt;br&gt;Config + permissions&lt;br&gt;Shared objects (Batch Ops)&lt;br&gt;&lt;i&gt;status: v1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#527FFF;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="210" height="130" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;2. Verify&lt;/b&gt;&lt;br&gt;&lt;br&gt;Permissions diff harness&lt;br&gt;Reconciliation&lt;br&gt;(counts, checksums, refs,&lt;br&gt;round-trip, objects)&lt;br&gt;&lt;i&gt;status: v1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="200" height="130" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;3. Flip&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only from v1 (lock held)&lt;br&gt;Freeze, drain router caches&lt;br&gt;Final delta + anti-join, config&lt;br&gt;Re-verify everything&lt;br&gt;&lt;i&gt;status: frozen&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#232F3E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="200" height="130" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;4. Redirect&lt;/b&gt;&lt;br&gt;&lt;br&gt;Placement → cell&lt;br&gt;Router sends the tenant to V2&lt;br&gt;&lt;i&gt;status: v2&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;granting the cell IAM + KMS&lt;br&gt;access is a runbook step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;strokeWidth=2;fontSize=12;fontColor=#232F3E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="200" height="130" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;5. Forget&lt;/b&gt;&lt;br&gt;&lt;br&gt;After the retention window:&lt;br&gt;dry run, then delete&lt;br&gt;the tenant's V1 copy&lt;br&gt;&lt;i&gt;status: v2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="190" height="130" as="geometry"/></mxCell>
<mxCell id="c1" value="tenantmig migrate-* (or demo)" style="text;html=1;align=center;fontSize=11;fontColor=#527FFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="250" y="86" width="210" height="20" as="geometry"/></mxCell>
<mxCell id="c2" value="diff-permissions, reconcile" style="text;html=1;align=center;fontSize=11;fontColor=#8C4FFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="510" y="86" width="200" height="20" as="geometry"/></mxCell>
<mxCell id="c3" value="tenantmig cutover (Flip + Redirect)" style="text;html=1;align=center;fontSize=11;fontColor=#ED7100;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="760" y="86" width="450" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="tenantmig forget --confirm" style="text;html=1;align=center;fontSize=11;fontColor=#545B64;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1260" y="86" width="190" height="20" as="geometry"/></mxCell>
<mxCell id="a0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f1" value="fail: fix and re-run Clone (every step is idempotent)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="320"/><mxPoint x="355" y="320"/></Array></mxGeometry></mxCell>
<mxCell id="f2" value="fail or any exception: roll back automatically (status v1). Nothing to undo in V1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="370"/><mxPoint x="115" y="370"/></Array></mxGeometry></mxCell>
<mxCell id="lane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E1E4E8;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="1420" height="150" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;Who does what&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="45" y="418" width="200" height="20" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;Router&lt;/b&gt; reads tenant_placement on each request: v1 → V1 platform; frozen → V1 read-only (writes rejected or queued); v2 → the tenant's cell. A cached placement is why Flip drains first." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="45" y="445" width="1390" height="22" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;Migration jobs&lt;/b&gt; run per tenant, can be re-run after any crash (each batch commits rows and watermark together; objects use conditional writes), and take an advisory lock so one pass runs per tenant." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="45" y="475" width="1390" height="36" as="geometry"/></mxCell>
<mxCell id="t4" value="&lt;b&gt;Freeze window&lt;/b&gt; is the drain (the router's cache TTL, or 0 if V1 blocks the tenant's writes) plus the final delta and re-verification. Re-verification scales with the whole tenant, not the delta, so measure it. Every transition is logged, and a tenant stuck frozen is reported by `where`." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="45" y="517" width="1390" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>