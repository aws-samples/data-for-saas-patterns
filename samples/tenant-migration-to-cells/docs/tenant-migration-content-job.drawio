<mxfile><diagram name="Content job" id="page-1"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Inside the content job: one batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;The same loop runs the bulk pass, every delta pass and the final pass at cutover.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="50" as="geometry"/></mxCell>
<mxCell id="s0" value="Take the per-tenant advisory lock&lt;br&gt;read watermark from migration.org_state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;Read the next batch&lt;/b&gt; from V1&lt;br&gt;WHERE org_id = X AND id &amp;gt; watermark ORDER BY id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#527FFF;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;content_ref = hash(content)&lt;/b&gt;&lt;br&gt;(your application's own hash code)&lt;br&gt;duplicates in the batch → one object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#527FFF;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="300" height="66" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;PUT object&lt;/b&gt; (concurrently)&lt;br&gt;key = ref[0:2]/ref&lt;br&gt;If-None-Match: *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="300" height="66" as="geometry"/></mxCell>
<mxCell id="d1" value="response?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="140" y="460" width="140" height="80" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;200&lt;/b&gt;: written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;412&lt;/b&gt;: already there&lt;br&gt;(dedupe, or a re-run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="250" y="572" width="150" height="56" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;COPY rows&lt;/b&gt; into the cell DB&lt;br&gt;(content dropped, content_ref set)&lt;br&gt;+ UPDATE watermark = last id&lt;br&gt;&lt;b&gt;one transaction, then commit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s3" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="next batch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#527FFF;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#527FFF;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="705"/><mxPoint x="450" y="198"/></Array></mxGeometry></mxCell>
<mxCell id="why" value="&lt;b&gt;Why it is safe to re-run&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Objects before rows.&lt;/b&gt; A row is only committed after its object exists, so no row points at missing content.&lt;br&gt;&lt;br&gt;&lt;b&gt;Crash after PUT, before commit.&lt;/b&gt; The objects exist but the rows and the watermark don't. The re-run reads the same batch again, gets 412 for the objects, and commits the rows. Nothing is duplicated.&lt;br&gt;&lt;br&gt;&lt;b&gt;Crash after commit.&lt;/b&gt; The watermark already covers the batch, so the re-run starts at the next one.&lt;br&gt;&lt;br&gt;&lt;b&gt;Two runs at once.&lt;/b&gt; The second can't take the advisory lock and stops.&lt;br&gt;&lt;br&gt;&lt;b&gt;Content changed upstream?&lt;/b&gt; A new hash gives a new object. Old objects are never overwritten.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dedupe for free.&lt;/b&gt; Identical content (system messages, forwards, chat noise) is stored once. The 412 response is the dedupe signal." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#AAB7B8;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="480" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>