<mxfile><diagram name="V1 to V2 migration" id="page-1"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Per-tenant migration from a pooled platform (V1) into a cell (V2), one organisation at a time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Content moves out of PostgreSQL into S3 by content hash; every step is re-runnable and verified before cutover. Synthetic data only.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="50" as="geometry"/></mxCell>
