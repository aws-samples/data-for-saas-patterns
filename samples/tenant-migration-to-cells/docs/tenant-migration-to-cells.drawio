<mxCell id="r3" value="CRR" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v2s3" target="drS3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="notes" value="&lt;b&gt;Per organisation:&lt;/b&gt; V1 stays live until a final delta pass at cutover; then the org moves to its cell by switching KMS and IAM access.&amp;nbsp; &lt;b&gt;Watch-outs:&lt;/b&gt; content_ref must be computed by exactly the same hash code as the V2 app; cells are already live, so throttle loads and watch AuroraGlobalDBReplicationLag; confirm messages are immutable (edits, retention deletes, legal holds); copied Intelligent-Tiering objects restart in Frequent Access; restore Glacier Deep Archive objects before copy; check the bucket quota against org count." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1730" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>