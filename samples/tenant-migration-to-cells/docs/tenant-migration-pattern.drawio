<mxfile><diagram name="Pattern" id="page-1"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Per-tenant migration from a pooled platform into a cell&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;One tenant at a time. The target schema differs: message content moves out of PostgreSQL into a per-tenant S3 bucket, keyed by a hash of the content.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1340" height="50" as="geometry"/></mxCell>
<mxCell id="laneV1" value="V1: pooled platform (source)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="280" height="580" as="geometry"/></mxCell>
<mxCell id="laneMig" value="Migration pipeline: runs per tenant, every step re-runnable" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5FAF0;strokeColor=#7AA116;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="660" height="580" as="geometry"/></mxCell>
<mxCell id="laneV2" value="V2: one cell (target)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#527FFF;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1030" y="80" width="330" height="580" as="geometry"/></mxCell>
<mxCell id="v1msg" value="Messaging database&lt;br&gt;Aurora PostgreSQL&lt;br&gt;&lt;i&gt;content stored in the row&lt;/i&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#527FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="140" y="130" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="v1auth" value="Auth database&lt;br&gt;users, roles, rules&lt;br&gt;+ application catalogue" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#527FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="v1s3" value="Shared bucket&lt;br&gt;one prefix per tenant" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.bucket_with_objects;" vertex="1" parent="1"><mxGeometry x="141" y="470" width="50" height="52" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1–3 Content job&lt;/b&gt;&lt;br&gt;hash the content, PUT it only if absent&lt;br&gt;(If-None-Match), then COPY the row&lt;br&gt;with content_ref. Rows and the&lt;br&gt;watermark commit together." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#527FFF;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4 Delta passes&lt;/b&gt;&lt;br&gt;same job, from the watermark. Rows&lt;br&gt;newer than a safety margin are held&lt;br&gt;back, and the watermark never passes&lt;br&gt;one, so late commits aren't skipped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#527FFF;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="212" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;5 Config + permissions&lt;/b&gt;&lt;br&gt;SQL over postgres_fdw as a read-only&lt;br&gt;role. Wildcards expanded against the&lt;br&gt;catalogue, denies subtracted, changes&lt;br&gt;and deletions converged. Credentials&lt;br&gt;become a secret reference." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="304" width="250" height="88" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;6 Permissions diff harness&lt;/b&gt;&lt;br&gt;evaluates the V1 model independently&lt;br&gt;(not via the transform's SQL) over every&lt;br&gt;catalogue entry, and lists every&lt;br&gt;disagreement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="660" y="304" width="250" height="88" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;7 Existing objects&lt;/b&gt;&lt;br&gt;S3 Batch Operations Copy, one job per&lt;br&gt;tenant, from a manifest of the keys the&lt;br&gt;destination is missing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="460" width="250" height="72" as="geometry"/></mxCell>
<mxCell id="s8" value="&lt;b&gt;8 Reconciliation&lt;/b&gt; — the gate&lt;br&gt;row counts; checksums per ID range;&lt;br&gt;every content_ref resolves to an object;&lt;br&gt;a sampled object round-trips; every&lt;br&gt;shared object copied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="660" y="448" width="250" height="88" as="geometry"/></mxCell>
<mxCell id="life" value="&lt;b&gt;Flip → Redirect → Forget&lt;/b&gt;&amp;nbsp; (one command: cutover)&lt;br&gt;Refuse unless the tenant is still on V1 · freeze its writes · drain · final pass (no margin, plus an anti-join against the cell) · re-verify · set tenant_placement to the cell.&lt;br&gt;Any failure or interruption sets it back to V1: V1 stayed authoritative throughout. Forget deletes the V1 copy afterwards, dry run first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="370" y="556" width="540" height="88" as="geometry"/></mxCell>
<mxCell id="v2msg" value="Cell messaging database&lt;br&gt;Aurora PostgreSQL&lt;br&gt;&lt;i&gt;content_ref, not content&lt;/i&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#527FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="1130" y="130" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="v2mgmt" value="Management database&lt;br&gt;principals, grants, connectors&lt;br&gt;&lt;b&gt;+ tenant_placement&lt;/b&gt; (routing)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#527FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="1130" y="300" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="v2s3" value="Per-tenant bucket&lt;br&gt;content keyed by hash,&lt;br&gt;copied objects under originals/" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.bucket_with_objects;" vertex="1" parent="1"><mxGeometry x="1131" y="470" width="50" height="52" as="geometry"/></mxCell>
<mxCell id="router" value="&lt;b&gt;Request router&lt;/b&gt; (your application)&lt;br&gt;reads tenant_placement: v1 → V1 · frozen → V1, writes paused · v2 → this cell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1050" y="570" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="e1" value="history" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F5FAF0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="v1msg" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="new rows" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F5FAF0;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1msg" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="platform config" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#F2F3F3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1msg" target="s5"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="156"/><mxPoint x="70" y="326"/></Array><mxPoint x="-6" y="-10" as="offset"/></mxGeometry></mxCell>
<mxCell id="e4" value="users, rules, catalogue" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#F5FAF0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1auth" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="objects" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.5;fontSize=10;fontColor=#3F6212;labelBackgroundColor=#F5FAF0;" edge="1" parent="1" source="v1s3" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="v2msg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="158"/><mxPoint x="1000" y="156"/></Array></mxGeometry></mxCell>
<mxCell id="e7" value="content objects" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.5;fontSize=10;fontColor=#3F6212;labelBackgroundColor=#F5FAF0;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="v2s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="185"/><mxPoint x="640" y="420"/><mxPoint x="1010" y="420"/><mxPoint x="1010" y="483"/></Array></mxGeometry></mxCell>
<mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="v2mgmt"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="copy" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.5;fontSize=10;fontColor=#3F6212;labelBackgroundColor=#F5FAF0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="v2s3"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="496"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
<mxCell id="e11" value="compares both sides" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#F5FAF0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8" target="v2s3"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="546"/><mxPoint x="965" y="546"/><mxPoint x="965" y="496"/><mxPoint x="1215" y="496"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
<mxCell id="e12" value="sets placement" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.5;fontSize=10;fontColor=#3F6212;labelBackgroundColor=#EEF4FF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="life" target="v2mgmt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="600"/><mxPoint x="1010" y="380"/><mxPoint x="1156" y="380"/></Array></mxGeometry></mxCell>
<mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="v2mgmt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1348" y="600"/><mxPoint x="1348" y="326"/></Array></mxGeometry></mxCell>
<mxCell id="foot" value="&lt;b&gt;What the sample deploys:&lt;/b&gt; four Aurora PostgreSQL Serverless v2 clusters and one cell, with the jobs as an on-demand AWS Fargate task. A production platform would run the same container as a Kubernetes job on Amazon EKS, one cell per shard of tenants, and add cross-Region replicas. Neither multi-Region nor EKS is built here: see docs/tenant-migration-sandbox.png for exactly what is." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="30" y="672" width="1330" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>